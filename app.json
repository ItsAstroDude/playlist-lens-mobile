{
  "expo": {
    "name": "playlist.lens",
    "slug": "playlist-lens-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "playlistlens",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/48e61e3d-b513-409f-aa32-1ce725a01d3e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111316"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andrei.playlistlens"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#111316"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.andrei.playlistlens"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "./plugins/withSafeUserLeaveHint",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Let playlist.lens use a photo as custom cover art."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#53e076"
        }
      ],
      "expo-sqlite",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Lavender",
            "android": {
              "foregroundImage": "./assets/icons/lavender-foreground.png",
              "backgroundColor": "#111316"
            }
          },
          {
            "name": "Pink",
            "android": {
              "foregroundImage": "./assets/icons/pink-foreground.png",
              "backgroundColor": "#111316"
            }
          },
          {
            "name": "Sky",
            "android": {
              "foregroundImage": "./assets/icons/sky-foreground.png",
              "backgroundColor": "#111316"
            }
          },
          {
            "name": "Amber",
            "android": {
              "foregroundImage": "./assets/icons/amber-foreground.png",
              "backgroundColor": "#111316"
            }
          },
          {
            "name": "Coral",
            "android": {
              "foregroundImage": "./assets/icons/coral-foreground.png",
              "backgroundColor": "#111316"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48e61e3d-b513-409f-aa32-1ce725a01d3e"
      }
    },
    "owner": "itsastrodudr",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
