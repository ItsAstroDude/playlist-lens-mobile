{
  "expo": {
    "name": "playlist.lens",
    "slug": "playlist-lens-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "playlistlens",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090910"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andrei.playlistlens"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090910"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.andrei.playlistlens"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "./plugins/withSafeUserLeaveHint"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48e61e3d-b513-409f-aa32-1ce725a01d3e"
      }
    },
    "owner": "itsastrodudr"
  }
}
